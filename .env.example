# npm run dev:demo works without this file. Synthetic data only.
PORT=3001
APP_ORIGIN=http://localhost:5173

# For npm run dev:live: real Tide auth and client-side key wrapping.
AUTH_MODE=tide
TIDE_ISSUER=http://localhost:8080/realms/privatechat
TIDE_AUDIENCE=privatechat
# Download the licensed app's Tide adapter to public/tidecloak.json.

# Demo uses .data/demo-conversations.json; live mode REQUIRES PostgreSQL.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/privatechat

# Set AI_PROVIDER=gemini + GEMINI_API_KEY to call real AI.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Gemini's model ID is deliberately explicit: choose an available model for your project.
PROVIDER_TIMEOUT_MS=30000
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100

# 32 random bytes encoded as 64 hex characters. Required for Tide mode review queue encryption.
APPROVAL_STORAGE_KEY=
